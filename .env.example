APP_NAME=Sodalitas
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Usado pelo compose.yaml para escolher qual Dockerfile buildar:
# Dockerfile.dev (desenvolvimento) ou Dockerfile (produção).
DOCKERFILE=Dockerfile.dev

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=sodalitas
DB_USERNAME=sodalitas
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=public
